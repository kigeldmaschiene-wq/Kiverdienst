# KIVerdienst v2 - Environment Configuration
# Copy this file to .env and configure with your values

# ???????????????????????????????????????????????????????????????
# REQUIRED: Database & Security
# ???????????????????????????????????????????????????????????????

# Database password (MUST CHANGE)
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_HERE

# Secret key for API (MUST CHANGE - use: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_HERE

# ???????????????????????????????????????????????????????????????
# OPTIONAL: AI Services
# ???????????????????????????????????????????????????????????????

# Ollama (Local LLM)
OLLAMA_URL=http://135.181.129.240:11434
OLLAMA_MODEL_LARGE=llama3.1:70b
OLLAMA_MODEL_FAST=llama3.1:8b-instruct-q8_0

# Runway Gen-3 (Video Generation)
RUNWAY_API_KEY=

# Azure Text-to-Speech
AZURE_TTS_KEY=
AZURE_TTS_REGION=westeurope

# ???????????????????????????????????????????????????????????????
# OPTIONAL: Marketing & Automation
# ???????????????????????????????????????????????????????????????

# SendGrid (Email Marketing)
SENDGRID_API_KEY=

# BrightData (Proxies for social media posting)
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# ???????????????????????????????????????????????????????????????
# Notes:
# - Only DB_PASSWORD and SECRET_KEY are REQUIRED for basic setup
# - AI services can be configured later
# - Generate secure passwords: openssl rand -base64 32
# ???????????????????????????????????????????????????????????????
