# KIVerdienst V2 - Environment Configuration
# Copy this to .env and adjust values

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kiverdienst_v2
DB_USER=postgres
DB_PASSWORD=kiverdienst2024secure

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# External API Keys (optional - leave empty if not used)
RUNWAY_API_KEY=
AZURE_TTS_KEY=
AZURE_TTS_REGION=westeurope
PEXELS_API_KEY=
PIXABAY_API_KEY=
SENDGRID_API_KEY=

# Ollama Configuration
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:70b

# Proxy Configuration (optional)
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Server Configuration
SERVER_IP=135.181.129.240
BACKEND_PORT=8000
FRONTEND_PORT=5000
